{
  "network": {
    "bridge_name": "homelab",
    "subnet": "172.20.0.0/16"
  },
  "defaults": {
    "restart_policy": "unless-stopped",
    "shared_data_path": "/mnt/storage/docker"
  },
  "containers": {
    "qbittorrent": "lscr.io/linuxserver/qbittorrent:latest",
    "gluetun": "qmcgaw/gluetun:latest",
    "sonarr": "lscr.io/linuxserver/sonarr:latest",
    "radarr": "lscr.io/linuxserver/radarr:latest",
    "lidarr": "lscr.io/linuxserver/lidarr:latest",
    "readarr": "lscr.io/linuxserver/readarr:latest",
    "bazarr": "lscr.io/linuxserver/bazarr:latest",
    "prowlarr": "lscr.io/linuxserver/prowlarr:latest",
    "overseerr": "sctx/overseerr:latest",
    "tautulli": "lscr.io/linuxserver/tautulli:latest",
    "nginx-proxy-manager": "jc21/nginx-proxy-manager:latest",
    "traefik": "traefik:v3.3",
    "ntfy": "binwiederhier/ntfy:latest",
    "vaultwarden": "vaultwarden/server:latest",
    "filebrowser": "filebrowser/filebrowser:latest"
  }
}
