#!/usr/bin/env bash
set -euo pipefail

echo "=================================================================="
echo "  STORAGE POOL & DISK USAGE"
echo "=================================================================="
df -h --output=target,fstype,size,used,avail,pcent | column -t

echo ""
echo "=================================================================="
echo "  BLOCK DEVICES & PARTITION TOPOLOGY"
echo "=================================================================="
lsblk -o NAME,SIZE,FSTYPE,TYPE,MOUNTPOINT
